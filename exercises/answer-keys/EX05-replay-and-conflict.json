  "question_answers": [
    {
      "question": 1,
      "answer": "SPM-4 (specimen type) is 'ZZZ^Unknown Specimen^L'. ZZZ is not a recognized specimen code, so ingestion raised SPECIMEN_UNRECOGNIZED (SPECIMEN / REDRIVE_ONLY). The corrected payload carries BMA (bone marrow), which matches the panel.",
      "sources": [
        "src/interfaces/inbound_hl7.py _check_specimen",
        "validation/v1.1-design-record.md sec 6"
      ]
    },
    {
      "question": 2,
      "answer": "A matching replay: the queue item, action, payload fingerprint, and actor all match the recorded request, so the service returned the existing SUCCEEDED attempt (same attempt_id) and wrote nothing: no message, result, attempt, or audit row.",
      "sources": [
        "validation/v1.1-design-record.md sec 9, sec 11 (I-02 steps 4-5)",
        "R-034"
      ]
    },
    {
      "question": 3,
      "answer": "The actor differed (analyst02 instead of analyst01), so reusing EX05-REDRIVE-1 is a REQUEST_ID_CONFLICT. It creates no message, attempt, or result and never changes the original attempt; it records exactly one audit_event with action REQUEST_ID_CONFLICT on entity interface_error_queue (order_id NULL, actor analyst02). get_recovery_history excludes it because no attempt row exists; recover history lists it as a conflict audit event, and reconcile reports it as REC-008 (INFO).",
      "sources": [
        "validation/v1.1-design-record.md sec 9",
        "R-041",
        "src/recovery.py _record_conflict, get_recovery_history"
      ]
    },
    {
      "question": 4,
      "answer": "The queue item was already RESOLVED. A fresh request against a closed item records a REJECTED attempt with no processing message, no result change, and no filing event. At most one SUCCEEDED attempt per queue item is also enforced by a partial unique index in schema.sql.",
      "sources": [
        "validation/v1.1-design-record.md sec 8, sec 9, sec 11 (I-02 steps 6-8)",
        "R-035",
        "R-036",
        "schema.sql idx_recovery_attempt_single_success"
      ]
    },
    {
      "question": 5,
      "answer": "One INBOUND_RESULT_FILED event (naming message_id=2) and nine RESULT_ENTERED events. The replay, the conflict, and the rejected request did not file again, so the results were applied exactly once.",
      "sources": [
        "R-016",
        "R-036",
        "validation/v1.1-design-record.md sec 11 (I-02)"
      ]
    }
